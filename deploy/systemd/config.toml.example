# Configuration of the DNS change monitor when it runs under systemd.
#
# The file is read by /etc/systemd/system/dnsmon.service. The token of the
# bot is not written here: it is read from the environment file
# /etc/dnsmon/dnsmon.env, in the variable DNSMON_TELEGRAM_TOKEN.

[database]
# The absolute location of the SQLite file. The service declares
# StateDirectory=dnsmon, so systemd creates /var/lib/dnsmon and lets the
# service write in it.
path = "/var/lib/dnsmon/dnsmon.db"

[telegram]
# The accounts allowed to pair with the bot and to receive the reports.
notify_usernames = ["alice"]

# How long a long poll request waits for new updates.
poll_timeout_seconds = 30

[monitor]
# The delay between two consecutive checks of the monitored records.
interval_seconds = 60

# The name servers used by the records that do not name one.
resolvers = ["1.1.1.1:53", "8.8.8.8:53"]

# The timeout of a single query.
timeout_seconds = 5

# Whether the first observation of a record is reported.
notify_on_baseline = false

# The records to watch. They are reconciled with the database at every start:
# a record removed from this file stops being watched.
#
# A record may also declare how it is checked, with the mode key:
#
#   change  the default, the answer is compared with the previous
#           observation and there is no value to check against
#   any     the record must carry at least one answer
#   exact   the answer must be exactly the listed values
#   regex   at least one answer must match the listed pattern, which is a
#           Go regular expression (RE2) searched anywhere in the answer
[[monitor.records]]
name = "example.com"
type = "A"

# The answer must be exactly 1.2.3.4.
#[[monitor.records]]
#name = "example.com"
#type = "A"
#mode = "exact"
#expect = ["1.2.3.4"]

# At least one answer must match the pattern.
#[[monitor.records]]
#name = "example.com"
#type = "TXT"
#mode = "regex"
#expect = ["^v=spf1"]

# The record must exist.
#[[monitor.records]]
#name = "example.com"
#type = "NS"
#mode = "any"

[pairing]
# How long a pairing token stays redeemable.
token_ttl_minutes = 30

[log]
# One of debug, info, warn or error.
level = "info"
# One of text or json. It applies to the standard output only.
format = "text"
# The plain text log file, one line per event. The service declares
# StateDirectory=dnsmon, so the file is written in /var/lib/dnsmon.
file = "/var/lib/dnsmon/dnsmon-events.log"
# The minimum severity written to the log file. It defaults to the level
# of the standard output.
file_level = "info"
