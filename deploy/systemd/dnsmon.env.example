# Environment of the DNS change monitor, read by systemd from
# /etc/dnsmon/dnsmon.env.
#
# The file holds the token of the Telegram bot so that the secret never has
# to be written in the configuration file. It must be readable only by root:
#
#   sudo install -m 0600 -o root -g root dnsmon.env.example /etc/dnsmon/dnsmon.env
#
# The variable overrides the "token" key of the configuration file.

DNSMON_TELEGRAM_TOKEN=123456789:replace-me-with-the-token-of-your-bot
